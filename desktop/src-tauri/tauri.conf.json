{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "woli",
  "version": "../package.json",
  "identifier": "app.basework.desktop",
  "build": {
    "frontendDist": "../shell",
    "beforeDevCommand": "node scripts/prepare-shell.mjs",
    "beforeBuildCommand": "node scripts/prepare-shell.mjs"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "woli",
    "copyright": "© woli",
    "category": "Productivity",
    "shortDescription": "woli - HR projects, tasks and goals",
    "longDescription": "Desktop client for woli: signs in to the same account and server as the web app; no business data is stored on this PC.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
