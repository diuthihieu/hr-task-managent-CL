// Prisma schema for the internal work management platform.
//
// Dynamic-field storage strategy (see also README.md "Architecture"):
// Workspace/Base/Table/Field are fully relational rows - adding a custom
// field never touches SQL DDL, it just inserts a Field row. Each Record
// stores its cell values in a single JSON `data` column keyed by Field id
// (`{ [fieldId]: value }`). This keeps reads cheap (one row = one record,
// no N-way join across a value-per-row EAV table) while metadata (types,
// options, formulas, relationships) stays fully relational and queryable.
// For Phase 7 (scale-out) this can be complemented with a typed
// `RecordValue` index table for columns that need SQL-level filtering;
// the JSON column is deliberately scoped to one record's cells, not a
// whole-app blob, so that optimization is additive, not a rewrite.
//
// NOTE ON PROVIDER: Postgres (Supabase). `directUrl` is a non-pooled
// connection used only for migrations; `url` is the pooled (Supavisor
// transaction-mode) connection used by the app at runtime, required when
// running on serverless platforms like Vercel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & workspace
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())

  memberships          WorkspaceMember[]
  recordsCreated       Record[]               @relation("RecordCreatedBy")
  comments             Comment[]
  auditLogs            AuditLog[]
  objectivesOwned      Objective[]            @relation("ObjectiveOwner")
  keyResultsOwned      KeyResult[]            @relation("KeyResultOwner")
  objectiveContributes ObjectiveContributor[]
  capturedThoughts     CapturedThought[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members          WorkspaceMember[]
  bases            Base[]
  auditLogs        AuditLog[]
  teams            Team[]
  objectives       Objective[]
  capturedThoughts CapturedThought[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("editor") // owner | admin | editor | contributor | viewer
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ---------------------------------------------------------------------------
// Base / Table / Field / Record - the core dynamic database engine
// ---------------------------------------------------------------------------

model Base {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String   @default("Database")
  color       String   @default("#6366f1")
  description String?
  order       Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tables     TableDef[]
  dashboards Dashboard[]
  workflows  Workflow[]

  @@index([workspaceId])
}

// Named TableDef because `Table` collides with SQL semantics in some tooling.
model TableDef {
  id          String   @id @default(cuid())
  baseId      String
  name        String
  icon        String   @default("Sheet")
  description String?
  order       Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  base    Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields  Field[]
  records Record[]
  views   View[]

  @@index([baseId])
}

model Field {
  id           String   @id @default(cuid())
  tableId      String
  name         String
  type         String // see src/lib/field-types.ts FieldType union
  config       String? // JSON: select options, formula expression, link target, number precision...
  order        Int      @default(0)
  isPrimary    Boolean  @default(false)
  visible      Boolean  @default(true)
  description  String?
  defaultValue String? // JSON-encoded default
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  table TableDef @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model Record {
  id          String   @id @default(cuid())
  tableId     String
  data        String   @default("{}") // JSON: { [fieldId]: value }
  order       Float    @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  table          TableDef        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("RecordCreatedBy", fields: [createdById], references: [id])
  comments       Comment[]
  keyResultLinks KeyResultTask[]

  @@index([tableId])
}

model View {
  id        String   @id @default(cuid())
  tableId   String
  name      String
  type      String   @default("grid") // grid | kanban | calendar | gantt | gallery | form
  config    String   @default("{}") // JSON: filters, sorts, groupBy, hiddenFields, columnOrder, conditionalFormatting...
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  isPublic  Boolean  @default(false) // form views only: allow anonymous submissions via /form/[id]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table TableDef @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model Comment {
  id        String   @id @default(cuid())
  recordId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([recordId])
}

// ---------------------------------------------------------------------------
// OKRs - Team > Objective > Key Result > Task. Objective/KeyResult progress
// is never stored: it's always derived at read time from KeyResultTask links
// (task-based) or from the KR's own value fields (numeric/percentage/manual),
// so a Task progress edit is reflected everywhere the instant it's read back
// - no write-fanout, nothing to keep in sync. See src/lib/okr-engine.ts.
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  objectives Objective[]

  @@index([workspaceId])
}

model Objective {
  id          String    @id @default(cuid())
  workspaceId String
  teamId      String?
  title       String
  description String?
  ownerId     String?
  cycleType   String    @default("quarter") // quarter | year | custom
  cycleLabel  String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("on_track") // not_started | on_track | at_risk | off_track | completed
  confidence  Int       @default(70)
  priority    String    @default("medium") // low | medium | high | critical
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team         Team?                  @relation(fields: [teamId], references: [id])
  owner        User?                  @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  contributors ObjectiveContributor[]
  keyResults   KeyResult[]

  @@index([workspaceId])
  @@index([teamId])
}

model ObjectiveContributor {
  id          String @id @default(cuid())
  objectiveId String
  userId      String

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId])
}

model KeyResult {
  id             String   @id @default(cuid())
  objectiveId    String
  title          String
  ownerId        String?
  type           String   @default("task_based") // task_based | numeric | percentage | manual
  startValue     Float    @default(0)
  targetValue    Float    @default(100)
  currentValue   Float    @default(0)
  unit           String?
  weight         Float    @default(1)
  manualProgress Float?
  status         String   @default("on_track")
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  objective Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner     User?           @relation("KeyResultOwner", fields: [ownerId], references: [id])
  taskLinks KeyResultTask[]

  @@index([objectiveId])
}

// The join between a Key Result and a Task record living in any Table -
// deliberately a real relational row (not a field stashed in Record.data)
// so progress rollup is a cheap indexed query instead of a cross-table scan.
model KeyResultTask {
  id          String   @id @default(cuid())
  keyResultId String
  tableId     String
  recordId    String
  weight      Float    @default(1)
  createdAt   DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  record    Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, recordId])
  @@index([recordId])
}

// ---------------------------------------------------------------------------
// Put All Things On - a lightweight capture inbox, deliberately NOT another
// task table: it only asks for what a fast brain-dump needs (name, rough
// duration, category, optional rough timing). Clarifying and converting a
// thought creates a real Record in the target Task table; the thought row
// then just remembers where that record ended up, for audit/undo.
// ---------------------------------------------------------------------------

model CapturedThought {
  id                       String    @id @default(cuid())
  workspaceId              String
  userId                   String
  taskName                 String
  tableId                  String // which Task table this will become a Record in
  categoryOptionId         String? // option id from that table's Category-like field
  estimatedDurationMinutes Int?
  plannedAt                DateTime? // user-entered planned date/time for the task
  status                   String    @default("captured") // captured | clarifying | converted | archived
  convertedRecordId        String?
  convertedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, status])
}

// ---------------------------------------------------------------------------
// Analytics - schema in place ahead of Phase 4 so it doesn't require a
// restructure later; not yet exposed in the UI.
// ---------------------------------------------------------------------------

model Dashboard {
  id        String   @id @default(cuid())
  baseId    String
  name      String
  layout    String   @default("[]") // unused; kept for compat, see DashboardBlock x/y/w/h
  filters   String   @default("{}") // JSON: dashboard-level FilterGroup + slicer values
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  base   Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  blocks DashboardBlock[]
}

model DashboardBlock {
  id          String @id @default(cuid())
  dashboardId String
  type        String // kpi | table | bar | column | line | area | pie | donut | combo | scatter | radar | treemap | funnel | gauge
  title       String @default("")
  config      String @default("{}") // JSON: data source, dimension, measure, aggregation, chart-level filters...
  x           Int    @default(0)
  y           Int    @default(0)
  w           Int    @default(4)
  h           Int    @default(4)
  order       Int    @default(0)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Automation - schema in place ahead of Phase 5.
// ---------------------------------------------------------------------------

model Workflow {
  id        String   @id @default(cuid())
  baseId    String
  name      String
  trigger   String   @default("{}") // JSON
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  base       Base                @relation(fields: [baseId], references: [id], onDelete: Cascade)
  nodes      WorkflowNode[]
  executions WorkflowExecution[]
}

model WorkflowNode {
  id         String  @id @default(cuid())
  workflowId String
  type       String // condition | action
  config     String  @default("{}")
  order      Int     @default(0)
  parentId   String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowExecution {
  id         String    @id @default(cuid())
  workflowId String
  status     String // success | error | running
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?
  log        String    @default("[]")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Attachments & audit
// ---------------------------------------------------------------------------

model Attachment {
  id        String   @id @default(cuid())
  recordId  String?
  fieldId   String?
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String // create | update | delete
  objectType  String // record | field | table | base | view
  objectId    String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId, objectType, objectId])
}
