// Prisma schema for the internal work management platform.
//
// Dynamic-field storage strategy (see also README.md "Architecture"):
// Workspace/Base/Table/Field are fully relational rows - adding a custom
// field never touches SQL DDL, it just inserts a Field row. Each Record
// stores its cell values in a single JSON `data` column keyed by Field id
// (`{ [fieldId]: value }`). This keeps reads cheap (one row = one record,
// no N-way join across a value-per-row EAV table) while metadata (types,
// options, formulas, relationships) stays fully relational and queryable.
// For Phase 7 (scale-out) this can be complemented with a typed
// `RecordValue` index table for columns that need SQL-level filtering;
// the JSON column is deliberately scoped to one record's cells, not a
// whole-app blob, so that optimization is additive, not a rewrite.
//
// NOTE ON PROVIDER: Postgres (Supabase). `directUrl` is a non-pooled
// connection used only for migrations; `url` is the pooled (Supavisor
// transaction-mode) connection used by the app at runtime, required when
// running on serverless platforms like Vercel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & workspace
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())

  memberships    WorkspaceMember[]
  recordsCreated Record[]          @relation("RecordCreatedBy")
  comments       Comment[]
  auditLogs      AuditLog[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members   WorkspaceMember[]
  bases     Base[]
  auditLogs AuditLog[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("editor") // owner | admin | editor | contributor | viewer
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ---------------------------------------------------------------------------
// Base / Table / Field / Record - the core dynamic database engine
// ---------------------------------------------------------------------------

model Base {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String   @default("Database")
  color       String   @default("#6366f1")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tables     TableDef[]
  dashboards Dashboard[]
  workflows  Workflow[]

  @@index([workspaceId])
}

// Named TableDef because `Table` collides with SQL semantics in some tooling.
model TableDef {
  id          String   @id @default(cuid())
  baseId      String
  name        String
  icon        String   @default("Sheet")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  base    Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields  Field[]
  records Record[]
  views   View[]

  @@index([baseId])
}

model Field {
  id           String   @id @default(cuid())
  tableId      String
  name         String
  type         String // see src/lib/field-types.ts FieldType union
  config       String? // JSON: select options, formula expression, link target, number precision...
  order        Int      @default(0)
  isPrimary    Boolean  @default(false)
  visible      Boolean  @default(true)
  description  String?
  defaultValue String? // JSON-encoded default
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  table TableDef @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model Record {
  id          String   @id @default(cuid())
  tableId     String
  data        String   @default("{}") // JSON: { [fieldId]: value }
  order       Float    @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  table     TableDef  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("RecordCreatedBy", fields: [createdById], references: [id])
  comments  Comment[]

  @@index([tableId])
}

model View {
  id        String   @id @default(cuid())
  tableId   String
  name      String
  type      String   @default("grid") // grid | kanban | calendar | gantt | gallery | form
  config    String   @default("{}") // JSON: filters, sorts, groupBy, hiddenFields, columnOrder, conditionalFormatting...
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  isPublic  Boolean  @default(false) // form views only: allow anonymous submissions via /form/[id]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table TableDef @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model Comment {
  id        String   @id @default(cuid())
  recordId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([recordId])
}

// ---------------------------------------------------------------------------
// Analytics - schema in place ahead of Phase 4 so it doesn't require a
// restructure later; not yet exposed in the UI.
// ---------------------------------------------------------------------------

model Dashboard {
  id        String   @id @default(cuid())
  baseId    String
  name      String
  layout    String   @default("[]") // unused; kept for compat, see DashboardBlock x/y/w/h
  filters   String   @default("{}") // JSON: dashboard-level FilterGroup + slicer values
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  base   Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  blocks DashboardBlock[]
}

model DashboardBlock {
  id          String @id @default(cuid())
  dashboardId String
  type        String // kpi | table | bar | column | line | area | pie | donut | combo | scatter | radar | treemap | funnel | gauge
  title       String @default("")
  config      String @default("{}") // JSON: data source, dimension, measure, aggregation, chart-level filters...
  x           Int    @default(0)
  y           Int    @default(0)
  w           Int    @default(4)
  h           Int    @default(4)
  order       Int    @default(0)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Automation - schema in place ahead of Phase 5.
// ---------------------------------------------------------------------------

model Workflow {
  id        String   @id @default(cuid())
  baseId    String
  name      String
  trigger   String   @default("{}") // JSON
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  base       Base                @relation(fields: [baseId], references: [id], onDelete: Cascade)
  nodes      WorkflowNode[]
  executions WorkflowExecution[]
}

model WorkflowNode {
  id         String  @id @default(cuid())
  workflowId String
  type       String // condition | action
  config     String  @default("{}")
  order      Int     @default(0)
  parentId   String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowExecution {
  id         String    @id @default(cuid())
  workflowId String
  status     String // success | error | running
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?
  log        String    @default("[]")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Attachments & audit
// ---------------------------------------------------------------------------

model Attachment {
  id        String   @id @default(cuid())
  recordId  String?
  fieldId   String?
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String // create | update | delete
  objectType  String // record | field | table | base | view
  objectId    String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId, objectType, objectId])
}
