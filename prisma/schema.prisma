// Basework - normalized relational schema (PostgreSQL).
//
// Design rules (see docs/DATABASE.md for the ER diagram and rationale):
// - Every major entity uses a UUID primary key generated by Postgres
//   (`gen_random_uuid()`), stored as the native `uuid` type.
// - Tables and columns are snake_case in the database (@@map / @map) while
//   the Prisma client stays camelCase.
// - Business entities carry created_at / updated_at / created_by /
//   updated_by. Entities users expect to "undo" or audit are soft-deleted
//   via deleted_at (+ deleted_by); every read path filters deleted_at IS NULL.
// - Reference data (statuses, categories, custom field options) is
//   hard-deleted with explicit ON DELETE behaviour instead, because keeping
//   ghost options around makes pickers and reports lie.
// - No business data lives in JSON blobs. JSONB is used only for UI state
//   (saved view config, dashboard widget config) and for the activity-log
//   change diff, none of which are queried relationally.
// - CHECK constraints that Prisma cannot express are added in migration SQL
//   (see the `constraints` migration), never by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Application-wide role. Only ADMIN can create accounts, (de)activate users,
/// reset passwords and create workspaces. ADMIN is treated as workspace owner
/// everywhere for support purposes.
enum SystemRole {
  ADMIN
  MEMBER

  @@map("system_role")
}

/// Role inside one workspace. Ordered from most to least privileged.
enum WorkspaceRole {
  owner
  admin
  editor
  contributor
  viewer

  @@map("workspace_role")
}

enum ProjectStatus {
  active
  on_hold
  completed
  archived

  @@map("project_status")
}

/// Semantic bucket every workspace status maps to. Progress, "done" counts
/// and overdue logic key off this, never off a status's display name.
enum StatusCategory {
  todo
  in_progress
  done
  cancelled

  @@map("status_category")
}

enum TaskPriority {
  low
  medium
  high
  critical

  @@map("task_priority")
}

enum Importance {
  important
  not_important

  @@map("importance")
}

enum Urgency {
  urgent
  not_urgent

  @@map("urgency")
}

enum DependencyType {
  finish_to_start
  start_to_start
  finish_to_finish
  start_to_finish

  @@map("dependency_type")
}

enum CustomFieldType {
  text
  long_text
  number
  currency
  percent
  rating
  checkbox
  date
  datetime
  single_select
  multi_select
  person
  url
  email
  phone
  formula

  @@map("custom_field_type")
}

enum ViewType {
  grid
  kanban
  calendar
  gantt
  gallery
  form
  eisenhower
  report

  @@map("view_type")
}

enum ObjectiveStatus {
  not_started
  on_track
  at_risk
  off_track
  completed

  @@map("objective_status")
}

enum CycleType {
  quarter
  year
  custom

  @@map("cycle_type")
}

enum KeyResultType {
  task_based
  numeric
  percentage
  manual

  @@map("key_result_type")
}

enum ThoughtStatus {
  captured
  converted
  archived

  @@map("thought_status")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lowercased; uniqueness is case-insensitive by construction.
  email              String     @unique @db.VarChar(254)
  name               String     @db.VarChar(120)
  /// Null for accounts that only sign in with Google.
  passwordHash       String?    @map("password_hash")
  /// Google account id ("sub") once the user has signed in with Google.
  googleSub          String?    @unique @map("google_sub") @db.VarChar(64)
  systemRole         SystemRole @default(MEMBER) @map("system_role")
  avatarColor        String     @default("#6366f1") @map("avatar_color") @db.VarChar(9)
  isActive           Boolean    @default(true) @map("is_active")
  /// Set for admin-created / admin-reset accounts; the user must pick their
  /// own password before using the app.
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  /// UI language: "vi" or "en".
  locale             String     @default("vi") @db.VarChar(5)
  /// Accent palette name (Tailwind palette, e.g. "indigo", "rose").
  accentColor        String     @default("orange") @map("accent_color") @db.VarChar(20)
  /// "light" | "dark" | "system" (follows the OS).
  themeMode          String     @default("system") @map("theme_mode") @db.VarChar(10)
  /// Surface tone: "neutral" | cool ("slate", "ocean", "mint") | warm ("sand", "rose", "amber").
  surfaceTone        String     @default("neutral") @map("surface_tone") @db.VarChar(20)
  /// Text size: "sm" | "md" | "lg" | "xl" (text only; layout stays put).
  fontSize           String     @default("md") @map("font_size") @db.VarChar(10)
  /// Display size (whole-UI scale): "compact" | "default" | "comfortable" | "large".
  displaySize        String     @default("default") @map("display_size") @db.VarChar(12)
  /// Uploaded profile picture (PNG/JPEG/WebP, <= 512 KB); omitted from queries by default.
  avatarData         Bytes?     @map("avatar_data")
  avatarType         String?    @map("avatar_type") @db.VarChar(40)
  avatarUpdatedAt    DateTime?  @map("avatar_updated_at") @db.Timestamptz(6)
  jobTitle           String?    @map("job_title") @db.VarChar(120)
  /// Personalization for every AI answer (like custom instructions in ChatGPT / Claude).
  aiAbout            String?    @map("ai_about")
  aiInstructions     String?    @map("ai_instructions")
  /// "professional" | "friendly" | "concise" | "coach" | "formal"
  aiTone             String     @default("professional") @map("ai_tone") @db.VarChar(20)
  /// "short" | "balanced" | "detailed"
  aiLength           String     @default("balanced") @map("ai_length") @db.VarChar(10)
  /// Notification groups (see NOTIFY_GROUPS) that should not pop up inside the app.
  notifyPopupOff     String[]   @default([]) @map("notify_popup_off")
  /// Notification groups that should not raise a desktop / mobile system notification.
  notifyNativeOff    String[]   @default([]) @map("notify_native_off")
  /// Ringtone played for a new notification ("none" = silent).
  notifySound        String     @default("chime") @map("notify_sound") @db.VarChar(20)
  /// Ringtone volume, 0-100.
  notifyVolume       Int        @default(70) @map("notify_volume") @db.SmallInt
  /// Bumped when credentials change or access is revoked; older session cookies stop working.
  sessionVersion     Int        @default(0) @map("session_version")
  /// When the user proved they own the email (Google sign-in, verification link, or an admin).
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?    @map("created_by") @db.Uuid
  updatedById        String?    @map("updated_by") @db.Uuid
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usersCreated User[] @relation("UserCreatedBy")
  updatedBy    User?  @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  usersUpdated User[] @relation("UserUpdatedBy")

  memberships           WorkspaceMember[]      @relation("MemberUser")
  projectsOwned         Project[]              @relation("ProjectOwner")
  taskAssignments       TaskAssignee[]         @relation("AssigneeUser")
  tasksCreated          Task[]                 @relation("TaskCreatedBy")
  tasksUpdated          Task[]                 @relation("TaskUpdatedBy")
  comments              Comment[]
  attachments           Attachment[]
  activityLogs          ActivityLog[]
  objectivesOwned       Objective[]            @relation("ObjectiveOwner")
  wikiPagesCreated      WikiPage[]             @relation("WikiCreatedBy")
  reportRecipientOf     TaskReportRecipient[]  @relation("ReportRecipientUser")
  notifications         Notification[]         @relation("NotificationUser")
  notificationsActed    Notification[]         @relation("NotificationActor")
  hiddenProjects        ProjectHiddenMember[]
  wikiPagesUpdated      WikiPage[]             @relation("WikiUpdatedBy")
  keyResultsOwned       KeyResult[]            @relation("KeyResultOwner")
  objectiveContributes  ObjectiveContributor[]
  capturedThoughts      CapturedThought[]
  customFieldUserValues TaskCustomFieldValue[] @relation("CustomValueUser")
  knowledgeDocs         KnowledgeDoc[]
  aiConversations       AiConversation[]
  aiSettingsUpdated     WikiAiSettings[]
  wikisCreated          Wiki[]                 @relation("WikiCreatedByUser")
  wikiMemberships       WikiMember[]
  commentMentions       CommentMention[]
  wikiComments          WikiComment[]          @relation("WikiCommentAuthor")
  approvalsRequested    TaskApproval[]         @relation("ApprovalRequester")
  approvalsToDecide     TaskApproval[]         @relation("ApprovalApprover")
  invitationsSent       WorkspaceInvitation[]  @relation("InvitationSender")
  invitationsReceived   WorkspaceInvitation[]  @relation("InvitationInvitee")
  inviteLinksCreated    WorkspaceInviteLink[]
  wikiCommentMentions   WikiCommentMention[]   @relation("WikiCommentMentionUser")
  focusSessions         FocusSession[]
  decisionsCreated      Decision[]             @relation("DecisionCreatedBy")
  decisionsOwned        Decision[]             @relation("DecisionOwner")
  decisionsInvolved     DecisionPerson[]       @relation("DecisionPeople")
  journalEntries        JournalEntry[]         @relation("JournalUser")
  knowledgeReviews      KnowledgeReview[]      @relation("ReviewUser")
  pointEvents           PointEvent[]           @relation("PointEventUser")
  recognitionManagerOf  RecognitionManager[]   @relation("RecognitionManagerUser")
  recognitionMemberOf   RecognitionMember[]    @relation("RecognitionMemberUser")
  kudosSent             Kudos[]                @relation("KudosFrom")
  kudosReceived         Kudos[]                @relation("KudosTo")
  redemptions           RewardRedemption[]     @relation("RedemptionUser")

  @@index([isActive, deletedAt])
  @@map("users")
}

model Workspace {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(120)
  slug          String    @unique @db.VarChar(80)
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by") @db.Uuid
  updatedById   String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Workspace logo (PNG/JPEG/WebP, max 256 KB), served by /api/workspaces/[id]/logo and used as the favicon.
  logoData      Bytes?    @map("logo_data")
  logoMimeType  String?   @map("logo_mime_type") @db.VarChar(40)
  /// Workspace admins must switch AI on: it sends workspace content to the AI provider.
  aiEnabled     Boolean   @default(false) @map("ai_enabled")
  logoUpdatedAt DateTime? @map("logo_updated_at") @db.Timestamptz(6)

  members             WorkspaceMember[]
  teams               Team[]
  projects            Project[]
  statuses            Status[]
  categories          Category[]
  tasks               Task[]
  objectives          Objective[]
  dashboards          Dashboard[]
  attachments         Attachment[]
  wikiComments        WikiComment[]
  taskApprovals       TaskApproval[]
  invitations         WorkspaceInvitation[]
  inviteLinks         WorkspaceInviteLink[]
  activityLogs        ActivityLog[]
  capturedThoughts    CapturedThought[]
  wikiPages           WikiPage[]
  notifications       Notification[]
  knowledgeDocs       KnowledgeDoc[]
  aiConversations     AiConversation[]
  wikis               Wiki[]
  decisions           Decision[]
  journalEntries      JournalEntry[]
  recognitionSettings RecognitionSettings?
  pointRules          PointRule[]
  pointEvents         PointEvent[]
  recognitionManagers RecognitionManager[]
  recognitionMembers  RecognitionMember[]
  kudos               Kudos[]
  rewards             Reward[]
  redemptions         RewardRedemption[]

  @@map("workspaces")
}

/// Many-to-many User <-> Workspace with a role on the join row.
model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(editor)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(120)
  color       String   @default("#6366f1") @db.VarChar(9)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  objectives Objective[]

  @@unique([workspaceId, name])
  @@map("teams")
}

// ---------------------------------------------------------------------------
// Work structure: projects, statuses, categories, tasks
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String        @db.VarChar(160)
  description String?
  color       String        @default("#6366f1") @db.VarChar(9)
  /// Optional icon key (see src/lib/project-icons.ts); null = no icon.
  icon        String?       @db.VarChar(40)
  status      ProjectStatus @default(active)
  ownerId     String?       @map("owner_id") @db.Uuid
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid
  updatedById String?       @map("updated_by") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedById String?       @map("deleted_by") @db.Uuid

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User?                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks            Task[]
  customFields     CustomField[]
  views            View[]
  capturedThoughts CapturedThought[]
  categories       Category[]
  hiddenMembers    ProjectHiddenMember[]
  notifications    Notification[]
  objectives       Objective[]
  decisions        Decision[]
  kudos            Kudos[]

  @@index([workspaceId, deletedAt, sortOrder])
  @@map("projects")
}

/// Workspace-level workflow states, shared by every project so reports can
/// aggregate across projects.
model Status {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  name        String         @db.VarChar(60)
  color       String         @default("#94a3b8") @db.VarChar(9)
  category    StatusCategory @default(todo)
  sortOrder   Int            @default(0) @map("sort_order")
  /// Status given to new tasks. At most one per workspace (partial unique
  /// index in the constraints migration).
  isDefault   Boolean        @default(false) @map("is_default")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?        @map("created_by") @db.Uuid
  updatedById String?        @map("updated_by") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
  @@map("statuses")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Categories are configured per project (when the project is created or
  /// later from the project's settings), not workspace-wide.
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(80)
  color       String   @default("#6366f1") @db.VarChar(9)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]
  capturedThoughts CapturedThought[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
  @@index([workspaceId])
  @@map("categories")
}

model Task {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from project for tenant-scoped indexes and authorization;
  /// kept consistent by the API (a task never moves across workspaces).
  workspaceId        String          @map("workspace_id") @db.Uuid
  projectId          String          @map("project_id") @db.Uuid
  /// Self-reference: subtasks.
  parentTaskId       String?         @map("parent_task_id") @db.Uuid
  statusId           String          @map("status_id") @db.Uuid
  categoryId         String?         @map("category_id") @db.Uuid
  keyResultId        String?         @map("key_result_id") @db.Uuid
  /// Objective the task contributes to. When a key result is chosen this is
  /// that key result's objective; it can also be set alone (objective only).
  objectiveId        String?         @map("objective_id") @db.Uuid
  title              String          @db.VarChar(500)
  description        String?
  /// Rich page body (sanitized HTML from the record page editor).
  content            String?
  priority           TaskPriority    @default(medium)
  importance         Importance?
  urgency            Urgency?
  startDate          DateTime?       @map("start_date") @db.Date
  dueDate            DateTime?       @map("due_date") @db.Date
  estimateMinutes    Int?            @map("estimate_minutes")
  /// Time actually spent (minutes): focus sessions add to it; can be edited by hand.
  actualMinutes      Int?            @map("actual_minutes")
  progress           Int             @default(0)
  /// Weight of this task inside its key result's task-based progress.
  okrWeight          Decimal         @default(1) @map("okr_weight") @db.Decimal(8, 2)
  sortOrder          Float           @default(0) @map("sort_order")
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?         @map("created_by") @db.Uuid
  updatedById        String?         @map("updated_by") @db.Uuid
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedById        String?         @map("deleted_by") @db.Uuid
  /// Recurring task: when it is completed the next occurrence is created
  /// (same details, dates moved by the interval).
  recurrenceFreq     RecurrenceFreq? @map("recurrence_freq")
  recurrenceInterval Int?            @map("recurrence_interval")
  /// The occurrence this one was generated from (one next occurrence per task).
  recurrenceParentId String?         @unique @map("recurrence_parent_id") @db.Uuid

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recurrenceParent Task?                  @relation("Recurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceNext   Task?                  @relation("Recurrence")
  decisions        Decision[]
  kudos            Kudos[]
  parentTask       Task?                  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks         Task[]                 @relation("Subtasks")
  status           Status                 @relation(fields: [statusId], references: [id], onDelete: Restrict)
  category         Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  keyResult        KeyResult?             @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  objective        Objective?             @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  createdBy        User?                  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?                  @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignees        TaskAssignee[]
  reportTo         TaskReportRecipient[]
  notifications    Notification[]
  dependencies     TaskDependency[]       @relation("DependencySuccessor")
  dependents       TaskDependency[]       @relation("DependencyPredecessor")
  comments         Comment[]
  attachments      Attachment[]
  customValues     TaskCustomFieldValue[]
  thoughts         CapturedThought[]
  focusSessions    FocusSession[]
  approvals        TaskApproval[]

  @@index([projectId, deletedAt, sortOrder])
  @@index([workspaceId, deletedAt, dueDate])
  @@index([statusId])
  @@index([categoryId])
  @@index([keyResultId])
  @@index([objectiveId])
  @@index([parentTaskId])
  @@map("tasks")
}

/// Many-to-many Task <-> User.
model TaskAssignee {
  taskId       String   @map("task_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById String?  @map("assigned_by") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("AssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

/// Self-referencing many-to-many on Task: `taskId` depends on `dependsOnTaskId`.
/// Self-loops are blocked by a CHECK constraint; longer cycles by the API.
model TaskDependency {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String         @map("task_id") @db.Uuid
  dependsOnTaskId String         @map("depends_on_task_id") @db.Uuid
  type            DependencyType @default(finish_to_start)
  lagDays         Int            @default(0) @map("lag_days")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?        @map("created_by") @db.Uuid

  task      Task @relation("DependencySuccessor", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyPredecessor", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// Custom fields (typed EAV): definitions per project, options normalized,
// one value row per (task, field) with a typed column per value kind.
// ---------------------------------------------------------------------------

model CustomField {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  name        String          @db.VarChar(120)
  type        CustomFieldType
  description String?
  isRequired  Boolean         @default(false) @map("is_required")
  /// Presentation-only settings (precision, currency symbol, max rating,
  /// formula expression). Never holds values.
  settings    Json            @default("{}")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?         @map("created_by") @db.Uuid
  updatedById String?         @map("updated_by") @db.Uuid
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options CustomFieldOption[]
  values  TaskCustomFieldValue[]

  @@index([projectId, deletedAt, sortOrder])
  @@map("custom_fields")
}

model CustomFieldOption {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customFieldId String   @map("custom_field_id") @db.Uuid
  label         String   @db.VarChar(120)
  color         String   @default("#94a3b8") @db.VarChar(9)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customField CustomField            @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  values      TaskCustomFieldValue[]

  @@index([customFieldId, sortOrder])
  @@map("custom_field_options")
}

model TaskCustomFieldValue {
  taskId         String    @map("task_id") @db.Uuid
  customFieldId  String    @map("custom_field_id") @db.Uuid
  valueText      String?   @map("value_text")
  valueNumber    Decimal?  @map("value_number") @db.Decimal(20, 6)
  valueDate      DateTime? @map("value_date") @db.Timestamptz(6)
  valueBool      Boolean?  @map("value_bool")
  valueOptionId  String?   @map("value_option_id") @db.Uuid
  valueUserId    String?   @map("value_user_id") @db.Uuid
  /// multi_select only: array of custom_field_options ids.
  valueOptionIds String[]  @default([]) @map("value_option_ids") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?   @map("updated_by") @db.Uuid

  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField        @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  option      CustomFieldOption? @relation(fields: [valueOptionId], references: [id], onDelete: SetNull)
  user        User?              @relation("CustomValueUser", fields: [valueUserId], references: [id], onDelete: SetNull)

  @@id([taskId, customFieldId])
  @@index([customFieldId, valueNumber])
  @@index([customFieldId, valueDate])
  @@index([customFieldId, valueOptionId])
  @@map("task_custom_field_values")
}

// ---------------------------------------------------------------------------
// Collaboration: comments, attachments, activity
// ---------------------------------------------------------------------------

model Comment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  authorId        String?   @map("author_id") @db.Uuid
  /// Self-reference: threaded replies.
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  body            String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent   Comment?         @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies  Comment[]        @relation("CommentReplies")
  mentions CommentMention[]

  @@index([taskId, createdAt])
  @@map("comments")
}

/// File bytes live in object storage (Vercel Blob); only metadata here.
model Attachment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  /// Exactly one owner: a task (record page / Files) or a wiki page (inline images).
  taskId          String?   @map("task_id") @db.Uuid
  wikiPageId      String?   @map("wiki_page_id") @db.Uuid
  fileName        String    @map("file_name") @db.VarChar(255)
  contentType     String    @map("content_type") @db.VarChar(255)
  sizeBytes       Int       @map("size_bytes")
  storageProvider String    @default("vercel_blob") @map("storage_provider") @db.VarChar(40)
  storageKey      String    @map("storage_key")
  url             String
  uploadedById    String?   @map("uploaded_by") @db.Uuid
  /// Set when the file was attached to a wiki page comment (wikiPageId is then that page).
  wikiCommentId   String?   @map("wiki_comment_id") @db.Uuid
  /// Text extracted from the file for the wiki's AI (comment files); omitted from queries by default.
  extractedText   String?   @map("extracted_text")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  wikiComment WikiComment? @relation(fields: [wikiCommentId], references: [id], onDelete: SetNull)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  wikiPage    WikiPage?    @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId, deletedAt])
  @@index([wikiPageId])
  @@index([wikiCommentId])
  @@map("attachments")
}

/// Append-only audit trail. `entityId` is polymorphic (no FK) so history
/// survives hard deletes of reference data.
model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String   @map("entity_id") @db.Uuid
  action      String   @db.VarChar(40)
  summary     String?
  /// { field: { from, to } } for updates.
  changes     Json?
  /// Request metadata for security-relevant events (sign-in, credential changes...).
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Views & dashboards (UI configuration)
// ---------------------------------------------------------------------------

model View {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(120)
  type        ViewType @default(grid)
  /// Filters, sorts, grouping, hidden columns, widths... (UI state only).
  config      Json     @default("{}")
  sortOrder   Int      @default(0) @map("sort_order")
  isDefault   Boolean  @default(false) @map("is_default")
  /// Form views only: accept anonymous submissions at /form/[id].
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("views")
}

model Dashboard {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(120)
  filters     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]

  @@index([workspaceId])
  @@map("dashboards")
}

model DashboardWidget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardId String   @map("dashboard_id") @db.Uuid
  type        String   @db.VarChar(30)
  title       String   @default("") @db.VarChar(200)
  config      Json     @default("{}")
  x           Int      @default(0)
  y           Int      @default(0)
  w           Int      @default(4)
  h           Int      @default(4)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

// ---------------------------------------------------------------------------
// Goals (OKR): Objective -> Key Result -> Task
// ---------------------------------------------------------------------------

model Objective {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  teamId            String?         @map("team_id") @db.Uuid
  /// Self-reference: cascading goals (company -> team -> individual).
  parentObjectiveId String?         @map("parent_objective_id") @db.Uuid
  /// Project the objective was set up in (null = workspace-level objective).
  projectId         String?         @map("project_id") @db.Uuid
  /// Cascading OKRs: a key result of a higher-level objective that this
  /// objective delivers (a manager's KR becomes a team member's objective).
  parentKeyResultId String?         @map("parent_key_result_id") @db.Uuid
  ownerId           String?         @map("owner_id") @db.Uuid
  title             String          @db.VarChar(300)
  description       String?
  cycleType         CycleType       @default(quarter) @map("cycle_type")
  cycleLabel        String?         @map("cycle_label") @db.VarChar(40)
  startDate         DateTime?       @map("start_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  status            ObjectiveStatus @default(on_track)
  confidence        Int             @default(70)
  priority          TaskPriority    @default(medium)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?         @map("created_by") @db.Uuid
  updatedById       String?         @map("updated_by") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team            Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parentObjective Objective?             @relation("ObjectiveTree", fields: [parentObjectiveId], references: [id], onDelete: SetNull)
  childObjectives Objective[]            @relation("ObjectiveTree")
  owner           User?                  @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contributors    ObjectiveContributor[]
  keyResults      KeyResult[]
  decisions       Decision[]
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentKeyResult KeyResult?             @relation("KeyResultChildObjectives", fields: [parentKeyResultId], references: [id], onDelete: SetNull)
  tasks           Task[]

  @@index([workspaceId, deletedAt])
  @@index([teamId])
  @@index([projectId])
  @@index([parentKeyResultId])
  @@index([ownerId])
  @@map("objectives")
}

/// Many-to-many Objective <-> User.
model ObjectiveContributor {
  objectiveId String   @map("objective_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([objectiveId, userId])
  @@index([userId])
  @@map("objective_contributors")
}

model KeyResult {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectiveId    String          @map("objective_id") @db.Uuid
  ownerId        String?         @map("owner_id") @db.Uuid
  title          String          @db.VarChar(300)
  type           KeyResultType   @default(task_based)
  startValue     Decimal         @default(0) @map("start_value") @db.Decimal(20, 4)
  targetValue    Decimal         @default(100) @map("target_value") @db.Decimal(20, 4)
  currentValue   Decimal         @default(0) @map("current_value") @db.Decimal(20, 4)
  unit           String?         @db.VarChar(20)
  weight         Decimal         @default(1) @db.Decimal(8, 2)
  manualProgress Decimal?        @map("manual_progress") @db.Decimal(5, 2)
  status         ObjectiveStatus @default(on_track)
  /// Owner's confidence that the target will be hit (0-100).
  confidence     Int             @default(70)
  dueDate        DateTime?       @map("due_date") @db.Date
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?         @map("created_by") @db.Uuid
  updatedById    String?         @map("updated_by") @db.Uuid
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)

  objective       Objective   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner           User?       @relation("KeyResultOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks           Task[]
  childObjectives Objective[] @relation("KeyResultChildObjectives")

  @@index([objectiveId, deletedAt])
  @@map("key_results")
}

// ---------------------------------------------------------------------------
// Quick capture ("Put All Things On")
// ---------------------------------------------------------------------------

model CapturedThought {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String        @map("workspace_id") @db.Uuid
  userId                   String        @map("user_id") @db.Uuid
  projectId                String        @map("project_id") @db.Uuid
  categoryId               String?       @map("category_id") @db.Uuid
  taskName                 String        @map("task_name") @db.VarChar(500)
  estimatedDurationMinutes Int?          @map("estimated_duration_minutes")
  plannedAt                DateTime?     @map("planned_at") @db.Timestamptz(6)
  status                   ThoughtStatus @default(captured)
  convertedTaskId          String?       @map("converted_task_id") @db.Uuid
  convertedAt              DateTime?     @map("converted_at") @db.Timestamptz(6)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  convertedTask Task?          @relation(fields: [convertedTaskId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([workspaceId, userId, status])
  @@map("captured_thoughts")
}

// ---------------------------------------------------------------------------
// Desktop client distribution. Installers are hosted as release assets
// (GitHub Releases); this table is the single source of truth for which
// build is "latest" (Download page) and for the Tauri updater manifest.
// ---------------------------------------------------------------------------

enum ReleaseChannel {
  stable
  beta

  @@map("release_channel")
}

model DesktopRelease {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Semantic version without a leading "v", e.g. "1.2.0".
  version            String         @db.VarChar(40)
  /// Tauri target triple family + arch, e.g. "windows-x86_64".
  platform           String         @default("windows-x86_64") @db.VarChar(40)
  channel            ReleaseChannel @default(stable)
  installerUrl       String         @map("installer_url")
  installerFileName  String         @map("installer_file_name") @db.VarChar(255)
  installerSizeBytes BigInt?        @map("installer_size_bytes")
  sha256             String?        @db.VarChar(64)
  /// Updater payload + minisign signature (Tauri updater). Null until updates are enabled.
  updaterUrl         String?        @map("updater_url")
  updaterSignature   String?        @map("updater_signature")
  minOsVersion       String         @default("Windows 10 (1803+) / Windows 11, 64-bit") @map("min_os_version") @db.VarChar(120)
  releaseNotes       String?        @map("release_notes")
  isPublished        Boolean        @default(true) @map("is_published")
  publishedAt        DateTime       @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Null when registered by CI with the release token.
  createdById        String?        @map("created_by") @db.Uuid
  updatedById        String?        @map("updated_by") @db.Uuid

  @@unique([platform, channel, version])
  @@index([platform, channel, isPublished, publishedAt(sort: Desc)])
  @@map("desktop_releases")
}

// ---------------------------------------------------------------------------
// Project wiki
// ---------------------------------------------------------------------------

/// A team wiki page inside a project. Pages nest (parent_page_id) so a
/// project can hold a small knowledge base next to its tasks.
model WikiPage {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  wikiId           String               @map("wiki_id") @db.Uuid
  parentPageId     String?              @map("parent_page_id") @db.Uuid
  title            String               @db.VarChar(300)
  icon             String?              @db.VarChar(16)
  /// Sanitized HTML produced by the rich-text editor.
  content          String?
  /// Projects whose data the page (or its comments) quotes - detected on every
  /// save. Anyone hidden from one of these projects can't see the page, in the
  /// UI, search or AI answers.
  sourceProjectIds String[]             @default([]) @map("source_project_ids") @db.Uuid
  /// What the page is (a meeting note, a retrospective, a reusable process...).
  kind             KnowledgeKind        @default(page)
  /// Free tags (lower-case, without "#").
  tags             String[]             @default([])
  // Temporal knowledge: which version is current, and for which period it holds.
  status           KnowledgeStatus      @default(current)
  validFrom        DateTime?            @map("valid_from") @db.Date
  validTo          DateTime?            @map("valid_to") @db.Date
  version          Int                  @default(1)
  /// The older page this one replaces (its "superseded by" is the inverse).
  supersedesId     String?              @unique @map("supersedes_id") @db.Uuid
  /// Meetings: when it took place.
  eventDate        DateTime?            @map("event_date") @db.Date
  // Source provenance.
  sourceType       KnowledgeSource      @default(manual) @map("source_type")
  sourceLabel      String?              @map("source_label") @db.VarChar(300)
  sourceUrl        String?              @map("source_url") @db.VarChar(1000)
  /// Entity the page was generated from ("task:<id>", "project:<id>").
  sourceRef        String?              @map("source_ref") @db.VarChar(120)
  confidence       KnowledgeConfidence?
  lastCheckedAt    DateTime?            @map("last_checked_at") @db.Timestamptz(6)
  lastCheckedById  String?              @map("last_checked_by") @db.Uuid
  /// Reading activity (Knowledge health: "never revisited").
  viewCount        Int                  @default(0) @map("view_count")
  lastViewedAt     DateTime?            @map("last_viewed_at") @db.Timestamptz(6)
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?              @map("created_by") @db.Uuid
  updatedById      String?              @map("updated_by") @db.Uuid
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedById      String?              @map("deleted_by") @db.Uuid

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wiki         Wiki              @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  parentPage   WikiPage?         @relation("WikiTree", fields: [parentPageId], references: [id], onDelete: Cascade)
  children     WikiPage[]        @relation("WikiTree")
  attachments  Attachment[]
  comments     WikiComment[]
  createdBy    User?             @relation("WikiCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?             @relation("WikiUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  supersedes   WikiPage?         @relation("Supersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy WikiPage?         @relation("Supersedes")
  layers       KnowledgeLayer?
  reviews      KnowledgeReview[]
  decisions    Decision[]

  @@index([wikiId, deletedAt, sortOrder])
  @@index([workspaceId, deletedAt, kind])
  @@index([parentPageId])
  @@map("wiki_pages")
}

// ---------------------------------------------------------------------------
// Reporting lines, notifications, project visibility
// ---------------------------------------------------------------------------

/// "Report to": people who are notified when the task's status or details change.
model TaskReportRecipient {
  taskId       String   @map("task_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById String?  @map("assigned_by") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("ReportRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_report_recipients")
}

/// In-app notification for one user. `dedupe_key` makes reminders (due soon,
/// overdue, forgotten quick captures) idempotent.
model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  workspaceId  String?   @map("workspace_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  taskId       String?   @map("task_id") @db.Uuid
  thoughtId    String?   @map("thought_id") @db.Uuid
  actorId      String?   @map("actor_id") @db.Uuid
  type         String    @db.VarChar(40)
  title        String    @db.VarChar(300)
  body         String?
  /// Parameters for rendering the message in the reader's language (status name, field names...).
  data         Json?
  link         String?   @db.VarChar(500)
  dedupeKey    String?   @map("dedupe_key") @db.VarChar(200)
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  /// Hidden from the inbox until this time (Snooze).
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)
  /// When the reader acted on it (Accept / Complete / Done) - it leaves the "To do" list.
  actionedAt   DateTime? @map("actioned_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  thought   CapturedThought? @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([taskId])
  @@map("notifications")
}

/// A project is visible to every workspace member except the people listed here.
model ProjectHiddenMember {
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_hidden_members")
}

/// Per-wiki AI assistant: the wiki manager's instructions (system prompt) and whether it's on.
model WikiAiSettings {
  wikiId       String   @id @map("wiki_id") @db.Uuid
  enabled      Boolean  @default(true)
  /// Manager-written instructions: role, tone, answer style, what to avoid.
  instructions String   @default("")
  /// Short welcome text shown above the chat.
  greeting     String?  @db.VarChar(500)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?  @map("updated_by") @db.Uuid

  wiki      Wiki  @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("wiki_ai_settings")
}

/// Reference document uploaded by the project owner. Only the extracted text is
/// stored; it's given to the model as grounding context (not fine-tuning).
model KnowledgeDoc {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  wikiId      String    @map("wiki_id") @db.Uuid
  fileName    String    @map("file_name") @db.VarChar(200)
  contentType String    @map("content_type") @db.VarChar(120)
  sizeBytes   Int       @map("size_bytes")
  text        String
  charCount   Int       @map("char_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wiki      Wiki      @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([wikiId, deletedAt])
  @@map("knowledge_docs")
}

enum AiConversationKind {
  wiki
  assistant
  brain
}

/// A user's private chat: with a project's wiki assistant, or with the workspace AI assistant.
model AiConversation {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  wikiId      String?            @map("wiki_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  kind        AiConversationKind
  title       String             @db.VarChar(200)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wiki      Wiki?       @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, workspaceId, kind, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

enum AiMessageRole {
  user
  model
}

model AiMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  tokensIn       Int?          @map("tokens_in")
  tokensOut      Int?          @map("tokens_out")
  /// Ask My Brain: the sources the answer was grounded on ([{ n, id, type, title, href }]).
  sources        Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum WikiAccess {
  /// Every workspace member can open it (with the wiki's default role).
  workspace
  /// Only the people added to it (plus workspace owners/admins).
  restricted
}

enum WikiRole {
  viewer
  editor
  manager
}

/// A knowledge space at workspace level. A workspace can have many wikis,
/// each with its own pages, access rule and AI assistant.
model Wiki {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  name        String     @db.VarChar(160)
  description String?
  icon        String?    @db.VarChar(16)
  color       String     @default("#f97316") @db.VarChar(9)
  access      WikiAccess @default(workspace)
  /// Role every workspace member gets when access = workspace (viewer or editor).
  defaultRole WikiRole   @default(editor) @map("default_role")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?    @map("created_by") @db.Uuid
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("WikiCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  members         WikiMember[]
  pages           WikiPage[]
  aiSettings      WikiAiSettings?
  knowledgeDocs   KnowledgeDoc[]
  aiConversations AiConversation[]

  @@index([workspaceId, deletedAt, sortOrder])
  @@map("wikis")
}

/// Explicit access to a wiki: required for restricted wikis, and raises the
/// default role on workspace-wide ones (e.g. make someone a manager).
model WikiMember {
  wikiId    String   @map("wiki_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      WikiRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wiki Wiki @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([wikiId, userId])
  @@index([userId])
  @@map("wiki_members")
}

/// People tagged with @ in a comment (the body stores @[Name](userId) tokens).
model CommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

enum FocusStatus {
  running
  paused
  completed
  cancelled
}

/// One focus block on a task. Time is accumulated across pauses; on completion
/// the minutes are added to the task's actual time. Kept for productivity analytics.
model FocusSession {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String      @map("workspace_id") @db.Uuid
  taskId         String      @map("task_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  status         FocusStatus @default(running)
  /// Planned length of this block (minutes).
  plannedMinutes Int?        @map("planned_minutes")
  /// Seconds counted before the current run (sum of previous runs).
  elapsedSeconds Int         @default(0) @map("elapsed_seconds")
  /// Start of the current run while status = running.
  resumedAt      DateTime?   @map("resumed_at") @db.Timestamptz(6)
  notes          String?
  /// [{ text, done }]
  checklist      Json?
  startedAt      DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?   @map("ended_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([taskId])
  @@index([workspaceId, startedAt])
  @@map("focus_sessions")
}

/// Discussion on a wiki page: Markdown body with @[Name](userId) mentions, optional files.
model WikiComment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  wikiPageId      String    @map("wiki_page_id") @db.Uuid
  authorId        String?   @map("author_id") @db.Uuid
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  body            String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wikiPage    WikiPage             @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  author      User?                @relation("WikiCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent      WikiComment?         @relation("WikiCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies     WikiComment[]        @relation("WikiCommentReplies")
  mentions    WikiCommentMention[]
  attachments Attachment[]

  @@index([wikiPageId, createdAt])
  @@map("wiki_comments")
}

model WikiCommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment WikiComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("WikiCommentMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("wiki_comment_mentions")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

/// A request for someone to sign off a task (e.g. payroll checked, offer letter OK).
model TaskApproval {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  taskId            String         @map("task_id") @db.Uuid
  requestedById     String?        @map("requested_by") @db.Uuid
  approverId        String         @map("approver_id") @db.Uuid
  status            ApprovalStatus @default(pending)
  note              String?        @db.VarChar(2000)
  decisionNote      String?        @map("decision_note") @db.VarChar(2000)
  /// Approving also moves the task to its first "done" status.
  completeOnApprove Boolean        @default(false) @map("complete_on_approve")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt         DateTime?      @map("decided_at") @db.Timestamptz(6)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approver    User      @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([approverId, status])
  @@map("task_approvals")
}

enum InvitationStatus {
  pending
  accepted
  declined
  revoked

  @@map("invitation_status")
}

/// A personal invitation to join a workspace, by email. The person must accept
/// before they become a member. Works before they have an account: it is
/// matched by email when they sign up.
model WorkspaceInvitation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  email         String           @db.VarChar(254)
  /// Set when the email belongs to an account (at invite time or when they sign up).
  invitedUserId String?          @map("invited_user_id") @db.Uuid
  role          WorkspaceRole    @default(editor)
  /// Secret for the personal link /invite/<token>.
  token         String           @unique @db.VarChar(64)
  status        InvitationStatus @default(pending)
  message       String?          @db.VarChar(500)
  invitedById   String?          @map("invited_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  respondedAt   DateTime?        @map("responded_at") @db.Timestamptz(6)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedUser User?     @relation("InvitationInvitee", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedBy   User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([invitedUserId, status])
  @@map("workspace_invitations")
}

/// Shareable join link for a workspace. Anyone signed in who opens it sees the
/// workspace and must accept to join, with the link's role. Admins can turn it
/// off or replace it (the old link stops working).
model WorkspaceInviteLink {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  token       String        @unique @db.VarChar(64)
  role        WorkspaceRole @default(contributor)
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  useCount    Int           @default(0) @map("use_count")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, revokedAt])
  @@map("workspace_invite_links")
}

// ---------------------------------------------------------------------------
// Work Second Brain: knowledge metadata, decisions, journal, layers, reviews
// ---------------------------------------------------------------------------

enum RecurrenceFreq {
  daily
  weekly
  monthly
}

enum KnowledgeKind {
  page
  meeting
  retrospective
  process
  note
}

enum KnowledgeStatus {
  draft
  current
  outdated
  superseded
  archived
}

enum KnowledgeSource {
  manual
  imported
  ai_generated
  converted
}

enum KnowledgeConfidence {
  low
  medium
  high
}

enum DecisionStatus {
  proposed
  active
  superseded
  revoked
}

/// Decision memory: what was decided, why, what else was considered, on what evidence.
model Decision {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  projectId     String?         @map("project_id") @db.Uuid
  /// Page the decision was recorded from (and block, for a precise link back).
  wikiPageId    String?         @map("wiki_page_id") @db.Uuid
  sourceBlockId String?         @map("source_block_id") @db.VarChar(40)
  taskId        String?         @map("task_id") @db.Uuid
  objectiveId   String?         @map("objective_id") @db.Uuid
  title         String          @db.VarChar(500)
  reason        String?
  /// [{ "option": "...", "whyNot": "..." }]
  alternatives  Json            @default("[]")
  evidence      String?
  sourceUrl     String?         @map("source_url") @db.VarChar(1000)
  decidedAt     DateTime        @default(dbgenerated("CURRENT_DATE")) @map("decided_at") @db.Date
  /// Who owns the decision (accountable for it and its review).
  ownerId       String?         @map("owner_id") @db.Uuid
  /// When the decision should be looked at again.
  reviewDate    DateTime?       @map("review_date") @db.Date
  status        DecisionStatus  @default(active)
  validFrom     DateTime?       @map("valid_from") @db.Date
  validTo       DateTime?       @map("valid_to") @db.Date
  supersedesId  String?         @unique @map("supersedes_id") @db.Uuid
  sourceType    KnowledgeSource @default(manual) @map("source_type")
  createdById   String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  wikiPage     WikiPage?        @relation(fields: [wikiPageId], references: [id], onDelete: SetNull)
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  objective    Objective?       @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("DecisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  owner        User?            @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  supersedes   Decision?        @relation("DecisionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Decision?        @relation("DecisionSupersedes")
  people       DecisionPerson[]

  @@index([workspaceId, deletedAt, decidedAt(sort: Desc)])
  @@index([workspaceId, reviewDate])
  @@index([projectId])
  @@index([wikiPageId])
  @@map("decisions")
}

model DecisionPerson {
  decisionId String   @map("decision_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user       User     @relation("DecisionPeople", fields: [userId], references: [id], onDelete: Cascade)

  @@id([decisionId, userId])
  @@index([userId])
  @@map("decision_people")
}

/// Daily note / work journal: the user's own notes for a day (the rest of the
/// journal - work done, meetings, decisions - is assembled from existing data).
model JournalEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  notes       String?
  /// Latest AI summary of the day (never replaces the notes).
  aiSummary   String?  @map("ai_summary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("JournalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, date])
  @@map("journal_entries")
}

/// Progressive summarization of a page. The page content stays the source;
/// highlights, key points, summary and insights are separate layers.
model KnowledgeLayer {
  pageId        String    @id @map("page_id") @db.Uuid
  /// [{ "id", "text", "blockId", "by", "at" }]
  highlights    Json      @default("[]")
  keyPoints     String?   @map("key_points")
  summary       String?
  insights      String?
  /// Page version (updatedAt) the AI layers were generated from - older means stale.
  generatedFrom DateTime? @map("generated_from") @db.Timestamptz(6)
  generatedAt   DateTime? @map("generated_at") @db.Timestamptz(6)
  updatedById   String?   @map("updated_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("knowledge_layers")
}

/// Spaced review of a page for one user (1, 3, 7, 14, 30, 60, 120 days).
model KnowledgeReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  pageId         String    @map("page_id") @db.Uuid
  stage          Int       @default(0)
  nextReviewAt   DateTime  @map("next_review_at") @db.Timestamptz(6)
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User     @relation("ReviewUser", fields: [userId], references: [id], onDelete: Cascade)
  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId, nextReviewAt])
  @@map("knowledge_reviews")
}

// ---------------------------------------------------------------------------
// Recognition: points, kudos letters, rewards
// ---------------------------------------------------------------------------

enum PointAction {
  task_completed
  task_on_time
  task_created
  comment_posted
  helped_colleague
  kudos_received
  kudos_sent
  wiki_page_created
  decision_recorded
  focus_hour
  approval_given
}

enum KudosStyle {
  gratitude
  appreciation
  teamwork
  above_beyond
  mentor
}

enum RedemptionStatus {
  pending
  approved
  rejected
  cancelled
}

/// Recognition settings of a workspace (created with defaults on first use).
model RecognitionSettings {
  workspaceId      String    @id @map("workspace_id") @db.Uuid
  enabled          Boolean   @default(true)
  /// Default for members: may they see other people's points?
  membersSeePoints Boolean   @default(true) @map("members_see_points")
  /// Activity before this date earns no points (null = all history).
  pointsSince      DateTime? @map("points_since") @db.Timestamptz(6)
  /// Points are materialized from activity incrementally; this is the high-water mark.
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(6)
  updatedById      String?   @map("updated_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("recognition_settings")
}

/// Points per action, set by admins / recognition managers.
model PointRule {
  workspaceId String      @map("workspace_id") @db.Uuid
  action      PointAction
  points      Int
  enabled     Boolean     @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, action])
  @@map("point_rules")
}

/// Points ledger: one row per rewarded action (idempotent per source).
model PointEvent {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  action      PointAction
  points      Int
  /// What earned it (task, comment, kudos… id, or a composite key).
  sourceId    String      @map("source_id") @db.VarChar(120)
  occurredAt  DateTime    @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("PointEventUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, action, sourceId])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, userId])
  @@map("point_events")
}

/// People an admin delegated recognition management to.
model RecognitionManager {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  grantedById String?  @map("granted_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("RecognitionManagerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("recognition_managers")
}

/// Per-member override: may this member see other people's points?
model RecognitionMember {
  workspaceId         String  @map("workspace_id") @db.Uuid
  userId              String  @map("user_id") @db.Uuid
  canViewOthersPoints Boolean @map("can_view_others_points")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("RecognitionMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("recognition_members")
}

/// A thank-you letter from one member to another.
model Kudos {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  fromId      String     @map("from_id") @db.Uuid
  toId        String     @map("to_id") @db.Uuid
  style       KudosStyle @default(gratitude)
  title       String     @db.VarChar(200)
  /// Card design the letter is shown on (classic, sunrise, botanical…).
  template    String     @default("classic") @db.VarChar(30)
  /// Editable opening and closing lines (default: "Dear <name>," / style closing).
  greeting    String?    @db.VarChar(200)
  closing     String?    @db.VarChar(200)
  /// Letter body (plain text).
  message     String
  /// What it is for ("for staying late to finish payroll").
  reason      String?    @db.VarChar(500)
  taskId      String?    @map("task_id") @db.Uuid
  projectId   String?    @map("project_id") @db.Uuid
  /// Values shown on the card (teamwork, ownership…).
  values      String[]   @default([])
  /// Shown on the recognition wall (otherwise only sender and receiver see it).
  isPublic    Boolean    @default(true) @map("is_public")
  readAt      DateTime?  @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from      User      @relation("KudosFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User      @relation("KudosTo", fields: [toId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([toId, createdAt(sort: Desc)])
  @@index([fromId])
  @@map("kudos")
}

/// Reward catalog item: costs points, has a money value and a limited stock.
model Reward {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  name          String    @db.VarChar(200)
  description   String?
  imageData     Bytes?    @map("image_data")
  imageMimeType String?   @map("image_mime_type") @db.VarChar(40)
  pointsCost    Int       @map("points_cost")
  price         Decimal?  @db.Decimal(14, 2)
  currency      String    @default("VND") @db.VarChar(8)
  /// Stock: how many can be approved in total.
  quantity      Int
  /// Approved redemptions so far (never more than quantity).
  approvedCount Int       @default(0) @map("approved_count")
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([workspaceId, deletedAt, sortOrder])
  @@map("rewards")
}

model RewardRedemption {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  rewardId     String           @map("reward_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  /// Points reserved (pending) or spent (approved).
  points       Int
  status       RedemptionStatus @default(pending)
  note         String?          @db.VarChar(1000)
  decisionNote String?          @map("decision_note") @db.VarChar(1000)
  decidedById  String?          @map("decided_by") @db.Uuid
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reward    Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user      User      @relation("RedemptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("reward_redemptions")
}

/// Fixed-window counters shared by every server instance (login, sign-up, public forms, uploads...).
model RateLimit {
  key     String   @id @db.VarChar(200)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limits")
}
