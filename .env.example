# Copy to .env and fill in. `.env` itself is git-ignored. Never commit real credentials.

# --- PostgreSQL ---------------------------------------------------------------
# Option A: local Postgres (`docker compose up postgres -d`, reads POSTGRES_PASSWORD)
POSTGRES_PASSWORD="basework"
DATABASE_URL="postgresql://basework:basework@localhost:5432/basework"
DIRECT_URL="postgresql://basework:basework@localhost:5432/basework"
# Option B: Supabase. Runtime goes through the transaction pooler (port 6543),
# migrations through the session/direct connection (port 5432):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Required (the server refuses to start without a real one, min 32 characters).
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- First admin (used by `npm run admin:bootstrap` and production builds) ----
# Creates the first system admin only if no admin exists yet. Omit
# ADMIN_PASSWORD (a secret env var) is required to create it - it is never
# generated or printed to logs. The admin must change it at first sign-in;
# remove ADMIN_PASSWORD from the environment afterwards.
ADMIN_EMAIL="you@company.com"
ADMIN_NAME="Your Name"
# ADMIN_PASSWORD="ChangeMe123"

# --- File attachments (Vercel Blob) --------------------------------------------
# Without a token, uploads are refused (503) and nothing is stored.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# BLOB_ACCESS="private"   # default; files are only served through an authorized API route

# --- Production operations ---------------------------------------------------
# Used by Vercel Cron to authenticate maintenance routes. Generate with:
# openssl rand -hex 32
# CRON_SECRET=""
# ACTIVITY_LOG_RETENTION_DAYS=365
# ACTIVITY_LOG_ARCHIVE_BATCH=2000
# Comma-separated exact hostnames that API Result custom fields may call.
# API_FIELD_ALLOWED_HOSTS="api.example.com"

# --- Local development only ---------------------------------------------------
# `npm run db:seed` creates a clearly-labelled [DEV] sample workspace and refuses
# to run against non-local databases.
# DEV_SEED_PASSWORD="devpassword1"

# --- Desktop releases ---------------------------------------------------------
# Shared secret that lets the desktop CI workflow register new installers
# (POST /api/desktop/releases). Same value as the GitHub Actions secret
# DESKTOP_RELEASE_TOKEN. At least 32 characters; generate with: openssl rand -hex 32
# DESKTOP_RELEASE_TOKEN=""

# --- AI (Gemini) - wiki assistant and AI Assistant ---
# Create a key at https://aistudio.google.com/apikey. Server-side only; never exposed to the browser.
# GEMINI_API_KEY=
# Optional: model id (default: the rolling "gemini-flash-latest" alias).
# GEMINI_MODEL=
# Optional: questions per user per 24 hours (default 60) and context size in characters (default 400000).
# AI_DAILY_LIMIT=60
# AI_CONTEXT_CHARS=400000
# Optional: comma list of models tried when the first is unavailable/overloaded.
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest

# --- Email (verification links) -----------------------------------------------
# Password sign-ups must verify their address before they can accept an email
# invitation. With Resend configured they get a link by email; without it a
# system admin confirms the address in the Admin console.
# Option 1 - SMTP, e.g. a Gmail account with an app password (no domain/DNS
# needed; personal Gmail has a daily sending limit). Used when set.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"            # 465 = TLS; 587 = STARTTLS (SMTP_SECURE overrides)
# SMTP_USER="you@gmail.com"
# SMTP_PASS=""               # the 16-character app password
# MAIL_FROM="woli <you@gmail.com>"
# Option 2 - Resend (needs a domain verified in Resend):
# RESEND_API_KEY=""
# MAIL_FROM="woli <no-reply@your-domain.com>"
# The same email also powers "Forgot password?" (a 1-hour, single-use link).

# --- Sign in with Microsoft (Entra ID) - optional --------------------------
# App registration in Microsoft Entra admin center; redirect URI:
#   https://<your-domain>/api/auth/callback/microsoft-entra-id
# ISSUER limits who can sign in: your tenant id for one organization
# (recommended), or https://login.microsoftonline.com/common/v2.0 for any
# Microsoft account. In multi-tenant mode a Microsoft email is only accepted
# (to create or link an account) when the optional "xms_edov" claim confirms
# the email domain; add it under Token configuration.
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# --- Operations ---------------------------------------------------------------
# Break-glass support access: system admins act as owners in every workspace
# while this is 1 (each workspace opened is audit-logged). Leave unset normally.
# ADMIN_SUPPORT_ACCESS=1
# Hosts desktop installers may be downloaded from (comma list, "*." = subdomains).
# DESKTOP_ARTIFACT_HOSTS="github.com,objects.githubusercontent.com,*.public.blob.vercel-storage.com"
# Run migrations as a separate, approved release job (npm run db:release) instead of in the Vercel build.
# SKIP_BUILD_MIGRATIONS=1

# --- Web Push (notifications while woli is closed: phones, installed apps, browsers) ---
# Generate once: npx web-push generate-vapid-keys   (keep the private key secret; never change it casually -
# a new key pair makes every device subscribe again). Without these, push is simply off.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:it@your-company.com"
