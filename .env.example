# Copy to .env and fill in. `.env` itself is git-ignored. Never commit real credentials.

# --- PostgreSQL ---------------------------------------------------------------
# Option A: local Postgres (`docker compose up postgres -d`)
DATABASE_URL="postgresql://basework:basework@localhost:5432/basework"
DIRECT_URL="postgresql://basework:basework@localhost:5432/basework"
# Option B: Supabase. Runtime goes through the transaction pooler (port 6543),
# migrations through the session/direct connection (port 5432):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
AUTH_TRUST_HOST=true

# --- First admin (used by `npm run admin:bootstrap` and production builds) ----
# Creates the first system admin only if no admin exists yet. Omit
# ADMIN_PASSWORD to get a generated one printed once. The admin must change it
# at first sign-in; remove ADMIN_PASSWORD from the environment afterwards.
ADMIN_EMAIL="you@company.com"
ADMIN_NAME="Your Name"
# ADMIN_PASSWORD="ChangeMe123"

# --- File attachments (Vercel Blob) --------------------------------------------
# Without a token, uploads are refused (503) and nothing is stored.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# BLOB_ACCESS="private"   # default; files are only served through an authorized API route

# --- Local development only ---------------------------------------------------
# `npm run db:seed` creates a clearly-labelled [DEV] sample workspace and refuses
# to run against non-local databases.
# DEV_SEED_PASSWORD="devpassword1"

# --- Desktop releases ---------------------------------------------------------
# Shared secret that lets the desktop CI workflow register new installers
# (POST /api/desktop/releases). Same value as the GitHub Actions secret
# DESKTOP_RELEASE_TOKEN. At least 32 characters; generate with: openssl rand -hex 32
# DESKTOP_RELEASE_TOKEN=""

# --- AI (Gemini) - wiki assistant and AI Assistant ---
# Create a key at https://aistudio.google.com/apikey. Server-side only; never exposed to the browser.
# GEMINI_API_KEY=
# Optional: model id (default: the rolling "gemini-flash-latest" alias).
# GEMINI_MODEL=
# Optional: questions per user per 24 hours (default 60) and context size in characters (default 400000).
# AI_DAILY_LIMIT=60
# AI_CONTEXT_CHARS=400000
# Optional: comma list of models tried when the first is unavailable/overloaded.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest,gemini-2.0-flash
